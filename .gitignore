# Ignore everything by default.
*

# Keep gitignore and README.
!.gitignore
!README.md

# Keep docs.
!docs/
!docs/**

# Keep configs.
!configs/
!configs/**

# Keep scripts.
!scripts/
!scripts/**

# Keep data configs (not actual data files).
!data/
!data/*.yaml
!data/*.md

# macOS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo
