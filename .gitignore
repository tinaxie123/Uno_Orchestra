# Ignore everything by default.
*

# Keep gitignore itself.
!.gitignore

# Keep the top-level entry point.
!README.md

# Keep the curated router workspace.
!router/
router/*
!router/README.md
!router/experiment_plan_v3.md
!router/EXPERIMENT_GUIDE_explained.md
!router/RUNBOOK_local_to_server.md

# Keep the docs under router/data/.
!router/data/
router/data/*
!router/data/schema_v1_1.md
!router/data/preflight_checklist.md

# Keep SFT training configs and scripts.
!configs/
!configs/sft/
!configs/sft/**
!scripts/
!scripts/sft/
!scripts/sft/**

# macOS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo
